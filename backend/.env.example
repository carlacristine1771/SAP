# Supabase / PostgreSQL
# Use a connection string JDBC do Supabase com SSL habilitado.
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=<username>
DB_PASSWORD=<password>

# JWT
JWT_SECRET=<minimo_32_caracteres>
JWT_EXPIRATION=86400000

# Chat: chave de criptografia das mensagens. Obrigatoria no perfil prod, sem
# valor padrao. Use um valor longo e aleatorio e mantenha-o entre deploys:
# troca-la torna ilegiveis as mensagens ja gravadas.
SAP_CHAT_SECRET=<chave_longa_e_aleatoria>

# Perfil: obrigatorio no Render. Sem ele o perfil dev e ativado.
SPRING_PROFILES_ACTIVE=prod

# Server
PORT=8080

# CORS: origens exatas do frontend, separadas por virgula, sem barra final.
# Obrigatoria no perfil prod. Sem ela (dev), apenas localhost:5173/4173.
SAP_CORS_ALLOWED_ORIGINS=https://<projeto>.vercel.app

# Administrador inicial: desabilitado por padrao. Habilite somente para criar a
# primeira conta e desabilite em seguida. A conta nasce com senha temporaria e
# uma conta existente (mesmo e-mail ou usuario) nunca e alterada.
SAP_BOOTSTRAP_ADMIN_ENABLED=false
# SAP_BOOTSTRAP_ADMIN_EMAIL=<email>
# SAP_BOOTSTRAP_ADMIN_USUARIO=<usuario>
# SAP_BOOTSTRAP_ADMIN_NOME=<nome>
# SAP_BOOTSTRAP_ADMIN_SENHA=<senha temporaria com 12+ caracteres>
